# Authentication
AUTH_SECRET="your-auth-secret-here" # Generate with: npx auth secret

# Database
DATABASE_URL="postgresql://user:password@host:5432/zekher?sslmode=require"
DATABASE_URL_READONLY="postgresql://readonly_user:password@host:5432/zekher?sslmode=require"

# AI API Keys
OPENAI_API_KEY="your-openai-api-key"
COHERE_API_KEY="your-cohere-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key"
XAI_API_KEY="your-xai-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"

# AWS
AWS_BEARER_TOKEN_BEDROCK="your-aws-bearer-token"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"

# Azure
AZURE_API_KEY="your-azure-api-key"
AZURE_RESOURCE_Name="your-azure-resource-name"

# Vercel (optional)
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"
VERCEL_GIT_COMMIT_SHA="local"

# Redis (optional)
REDIS_URL="your-redis-url"

# Clerk Authentication (optional)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your-clerk-publishable-key"
CLERK_SECRET_KEY="your-clerk-secret-key"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth"

# Sentry (optional)
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# Braintrust (optional)
BRAINTRUST_API_KEY="your-braintrust-api-key"

# AI Gateway (optional)
AI_GATEWAY_API_KEY="your-ai-gateway-api-key"

# Application
NODE_ENV="development"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_CONVEX_URL="https://your-project.convex.cloud"
